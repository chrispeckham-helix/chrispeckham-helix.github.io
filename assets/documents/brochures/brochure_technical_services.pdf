   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Group power concept as an organized set of diverse wrecking balls breaking down a cement wall together in solidarity with a common strategy as a business metaphor for society removing barriers with 3D illustration elements.</rdf:li>
    </rdf:Alt>
   </dc:description>
